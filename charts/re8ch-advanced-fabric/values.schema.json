{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["fabric", "pool", "advertisement", "nodes", "mihomoGateway", "advancedFabric", "headlampPlugin", "routerOS"],
  "properties": {
    "fabric": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "stage": {"type": "integer", "minimum": 0},
    "routerOS": {
      "type": "object",
      "required": ["enabled", "namespace", "credentialsSecret", "nodeSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string", "minLength": 1},
        "credentialsSecret": {
          "type": "object",
          "required": ["namespace", "name"],
          "properties": {
            "namespace": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1}
          }
        },
        "nodeSelector": {"type": "object"}
      }
    },
    "advancedFabric": {
      "type": "object",
      "required": ["enabled", "mode", "applyEnabled", "observeDays", "emergencyDisable", "nativeRoutingCIDR", "acceleratedCIDR", "serviceCIDR", "dns", "nodes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"enum": ["observe-only", "guarded-apply"]},
        "applyEnabled": {"type": "boolean"},
        "observeDays": {"type": "integer", "minimum": 0},
        "emergencyDisable": {"type": "boolean"},
        "timezone": {"type": "string", "const": "Asia/Shanghai"},
        "nativeRoutingCIDR": {"type": "string", "const": "10.42.0.0/16"},
        "acceleratedCIDR": {"type": "string", "const": "10.250.0.0/24"},
        "serviceCIDR": {"type": "string", "const": "10.251.0.0/24"},
        "dns": {
          "type": "object",
          "required": ["enabled", "image", "replicas", "pdbMinAvailable", "clusterDomain", "ttlSeconds", "upstreams", "service", "doh", "migration"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string", "minLength": 1},
            "replicas": {"type": "integer", "minimum": 2},
            "pdbMinAvailable": {"type": "integer", "minimum": 1},
            "clusterDomain": {"type": "string", "const": "cluster.local"},
            "ttlSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "upstreams": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "service": {
              "type": "object",
              "required": ["name", "clusterIP"],
              "properties": {
                "name": {"const": "advanced-fabric-dns"},
                "clusterIP": {"const": "10.43.65.40"}
              }
            },
            "doh": {
              "type": "object",
              "required": ["serviceName", "caSecretName"],
              "properties": {
                "serviceName": {"const": "advanced-fabric-doh"},
                "caSecretName": {"type": "string", "minLength": 1}
              }
            },
            "migration": {
              "type": "object",
              "required": ["phase"],
              "properties": {"phase": {"enum": ["shadow", "active", "rollback"]}}
            }
          }
        },
        "networkQuality": {
          "type": "object",
          "required": ["enabled", "enforcementEnabled", "victoriaMetricsServiceScrape", "intervalSeconds", "timeoutSeconds", "samples", "freshnessSeconds", "minimumCoverageRatio", "maximumLossRatio", "maximumRegionalP95Ms", "maximumCrossRegionP95Ms", "dns", "doh"],
          "properties": {
            "enabled": {"type": "boolean"},
            "enforcementEnabled": {"type": "boolean"},
            "victoriaMetricsServiceScrape": {"type": "boolean"},
            "intervalSeconds": {"type": "integer", "minimum": 10, "maximum": 300},
            "timeoutSeconds": {"type": "number", "minimum": 0.2, "maximum": 10},
            "samples": {"type": "integer", "minimum": 1, "maximum": 20},
            "freshnessSeconds": {"type": "integer", "minimum": 30, "maximum": 900},
            "minimumCoverageRatio": {"type": "number", "minimum": 0, "maximum": 1},
            "maximumLossRatio": {"type": "number", "minimum": 0, "maximum": 1},
            "maximumRegionalP95Ms": {"type": "number", "minimum": 1},
            "maximumCrossRegionP95Ms": {"type": "number", "minimum": 1},
            "dns": {
              "type": "object",
              "required": ["maximumFailureRatio", "maximumP95Ms", "requireTcp", "shadowEnabled", "shadowServiceName"],
              "properties": {
                "maximumFailureRatio": {"type": "number", "minimum": 0, "maximum": 1},
                "maximumP95Ms": {"type": "number", "minimum": 1},
                "requireTcp": {"type": "boolean"},
                "shadowEnabled": {"type": "boolean"},
                "shadowServiceName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
              }
            },
            "doh": {
              "type": "object",
              "required": ["enabled", "url", "caSecretName", "maximumFailureRatio", "maximumP95Ms"],
              "properties": {
                "enabled": {"type": "boolean"},
                "url": {"type": "string", "pattern": "^https://[a-z0-9.-]+/dns-query$"},
                "caSecretName": {"type": "string", "minLength": 1},
                "maximumFailureRatio": {"type": "number", "minimum": 0, "maximum": 1},
                "maximumP95Ms": {"type": "number", "minimum": 1}
              }
            }
          }
        },
        "controlPlaneApi": {
          "type": "object",
          "required": ["enabled", "vip", "port", "mode", "eligibleNodes", "primaryTransport", "fallbackTransport", "healthCheck"],
          "properties": {
            "enabled": {"type": "boolean"},
            "vip": {"type": "string", "pattern": "^$|^10\\.250\\.0\\.[0-9]{1,3}/32$"},
            "port": {"type": "integer", "const": 6443},
            "mode": {"const": "healthy-ecmp"},
            "eligibleNodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "guardedNodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "nodeOperations": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}}},
            "primaryTransport": {"const": "wireguard"},
            "fallbackTransport": {"const": "zerotier"},
            "healthCheck": {
              "type": "object",
              "required": ["address", "path", "intervalSeconds", "timeoutSeconds", "successThreshold", "failureThreshold", "withdrawDelaySeconds"],
              "properties": {
                "address": {"const": "127.0.0.1"},
                "path": {"const": "/readyz"},
                "intervalSeconds": {"type": "integer", "minimum": 2, "maximum": 60},
                "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 10},
                "successThreshold": {"type": "integer", "minimum": 1, "maximum": 10},
                "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 10},
                "withdrawDelaySeconds": {"type": "integer", "minimum": 0, "maximum": 30}
              }
            }
          }
        },
        "nodes": {"type": "array", "items": {"type": "object"}}
      }
    },
    "pool": {
      "type": "object",
      "required": ["cidr", "enabled"],
      "properties": {
        "cidr": {"type": "string", "pattern": "^$|^[0-9.]+/[0-9]+$"},
        "enabled": {"type": "boolean"}
      }
    },
    "headlampPlugin": {
      "type": "object",
      "required": ["enabled", "namespace", "pluginsPVC", "installImage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string", "minLength": 1},
        "pluginsPVC": {"type": "string", "minLength": 1},
        "installImage": {"type": "string", "minLength": 1}
      }
    },
    "mihomoGateway": {
      "type": "object",
      "required": ["enabled", "existingPathsSecret", "service"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingPathsSecret": {"type": "string"},
        "service": {
          "type": "object",
          "required": ["type", "advertise"],
          "properties": {
            "type": {"enum": ["ClusterIP", "LoadBalancer"]},
            "advertise": {"type": "boolean"},
            "requestedLoadBalancerIP": {"type": "string"}
          }
        }
      }
    }
  }
}
